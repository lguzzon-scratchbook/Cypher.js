{
  "name": "cypher",
  "version": "1.0.0",
  "description": "Cypher graph database query engine and graph database in Javascript. The Cypher query language in your browser! Zero dependencies",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.tests.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "js/CypherNG/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lguzzon-scratchbook/Cypher.js.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lguzzon-scratchbook/Cypher.js/issues"
  },
  "homepage": "https://github.com/lguzzon-scratchbook/Cypher.js#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0"
  }
}
