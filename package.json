{
  "author": "Niclas Kjäll-Ohlsson",
  "bugs": {
    "url": "https://github.com/niclasko/Cypher.js/issues"
  },
  "description": "Cypher graph database for Javascript",
  "homepage": "https://github.com/niclasko/Cypher.js#readme",
  "keywords": [
    "graph",
    "database",
    "cypher",
    "neo4j",
    "query",
    "javascript"
  ],
  "license": "GPL-3.0-or-later",
  "main": "js/Cypher.js",
  "name": "cypher.js",
  "optionalDependencies": {
    "gun": "^0.2020.1241",
    "redis": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niclasko/Cypher.js.git"
  },
  "scripts": {
    "_:update": "npx --yes -p npm-check-updates ncu -u ; npm install",
    "redis:health": "bash js/tests/scripts/redisManager.sh health",
    "redis:restart": "bash js/tests/scripts/redisManager.sh restart",
    "redis:start": "bash js/tests/scripts/redisManager.sh start",
    "redis:status": "bash js/tests/scripts/redisManager.sh status",
    "redis:stop": "bash js/tests/scripts/redisManager.sh stop",
    "test": "bash js/tests/scripts/test-runner.sh",
    "test:all": "bash js/tests/scripts/test-runner.sh --adapter all",
    "test:filesystem": "bash js/tests/scripts/test-runner.sh --adapter filesystem",
    "test:gundb": "bash js/tests/scripts/test-runner.sh --adapter gundb",
    "test:inmemory": "bash js/tests/scripts/test-runner.sh --adapter inmemory",
    "test:redis": "bash js/tests/scripts/test-runner.sh --adapter redis",
    "test:verbose": "bash js/tests/scripts/test-runner.sh --verbose"
  },
  "version": "1.0.0"
}